# ==========================================
# Backend Configuration (FastAPI / Python)
# ==========================================

# Your AI API Key (Currently mapped to Google Gemini by default in the code)
GOOGLE_API_KEY=""

# Authentication token for API routes (Change for production)
API_TOKEN="dev-kortexa-secret-token"

# Local paths to save downloaded videos and temporary files
STORAGE_PATH="./storage"
TEMP_PATH="./temp"

# Port where the Backend will run
PORT=8000

# ==========================================
# Local Transcription (faster-whisper)
# ==========================================
# Audio is transcribed on your own machine — it never leaves it.
# Model: tiny | base | small | medium | large-v3 (bigger = better and slower)
WHISPER_MODEL="large-v3"

# Device: auto (tries GPU, falls back to CPU) | cuda | cpu
WHISPER_DEVICE="auto"

# Leave empty for the default per device (float16 on GPU, int8 on CPU)
WHISPER_COMPUTE_TYPE=""

# ==========================================
# On-screen text OCR (EasyOCR)
# ==========================================
# Frames are read on your own machine — nothing leaves it.
# Comma-separated languages to recognize (latin-based can be combined)
OCR_LANGS="pt,en"

# 1 = run OCR on the GPU. Default 0 (CPU) keeps VRAM free for Whisper;
# 4 frames per reel are fast on CPU anyway.
OCR_GPU="0"

# ==========================================
# Mobile App Configuration (Expo / React Native)
# ==========================================

# Base URL of your FastAPI API. 
# If running on Android Emulator, use http://10.0.2.2:8000
# If testing on a physical device, set your machine's local IP (e.g., http://192.168.0.15:8000)
EXPO_PUBLIC_API_URL="http://10.0.2.2:8000"
